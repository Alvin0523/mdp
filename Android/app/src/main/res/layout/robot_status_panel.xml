<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/container_black"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView android:id="@+id/bluetoothConnection" android:layout_width="match_parent" android:layout_height="28dp" android:background="@drawable/status_bar" android:gravity="center" android:text="BLUETOOTH" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/bluetoothStatus" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="Not Connected" android:textColor="@android:color/holo_red_dark" />
    <TextView android:id="@+id/bluetoothConnectedDevice" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:text="Connected Device" android:textColor="@color/black" />
    <TextView android:layout_width="match_parent" android:layout_height="28dp" android:background="@drawable/status_bar" android:gravity="center" android:text="ROBOT STATUS" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/robotStatus" android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="Ready to Start" android:textColor="@color/colorBlack" />
    <TextView android:id="@+id/planStatus" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:text="PLAN: WAITING" android:textColor="@color/colorBlack" />
    <TextView android:id="@+id/resetStatus" android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center" android:text="RESET: WAITING" android:textColor="@color/colorBlack" />
    <TextView android:id="@+id/directionLabel" android:layout_width="match_parent" android:layout_height="28dp" android:background="@drawable/status_bar" android:gravity="center" android:text="DIRECTION" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
    <TextView android:id="@+id/directionAxisTextView" android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:text="None" android:textColor="@color/colorBlack" />
    <TextView android:id="@+id/CoordsLabel" android:layout_width="match_parent" android:layout_height="28dp" android:background="@drawable/status_bar" android:gravity="center" android:text="COORDINATES" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/robotX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X:" android:textColor="@color/colorBlack" />
        <TextView android:id="@+id/xAxisTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="0" android:textColor="@color/colorBlack" />
        <TextView android:id="@+id/robotY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="Y:" android:textColor="@color/colorBlack" />
        <TextView android:id="@+id/yAxisTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="0" android:textColor="@color/colorBlack" />
    </LinearLayout>
</LinearLayout>
